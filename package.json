{
  "name": "groot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "cms:types": "bun run --env-file=.env.local cms/gen-types.ts",
    "cms:seed": "bun run --env-file=.env.local cms/seed.ts",
    "content:export": "bun run cms/export-content.ts",
    "ml:train": "python3 ml/train.py",
    "ml:parity": "node ml/parity.mjs",
    "ml:train:chat": "uv run --python 3.12 --with numpy python ml/train_chat.py",
    "ml:parity:chat": "bun ml/parity_chat.mts",
    "ml:eval:chat": "bun ml/eval_chat.mts",
    "test": "bun test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-mcp": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-vercel-blob": "^3.88.0",
    "blobatar": "^2.7.0",
    "graphql": "^17.0.2",
    "next": "16.3.4",
    "payload": "^3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.5",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
