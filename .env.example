# ── Mail ─────────────────────────────────────────────────────────────────
# Resend key for the /contact form. Create one at https://resend.com/api-keys
# The sender domain in app/api/contact/route.ts (nare.li) must be verified in
# the same Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Payload ──────────────────────────────────────────────────────────────
# Signs admin sessions. Generate with: openssl rand -base64 32
# Changing it logs everyone out.
PAYLOAD_SECRET=

# Postgres. Locally this matches docker-compose.yml; in production paste the
# connection string from the Vercel Postgres (Neon) store.
POSTGRES_URL=postgres://groot:groot@localhost:5433/groot

# Where the admin builds absolute URLs from.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ── Media ────────────────────────────────────────────────────────────────
# Vercel Blob read/write token. Leave unset locally: uploads then go to
# public/uploads instead, and the Blob plugin stays switched off.
BLOB_READ_WRITE_TOKEN=

# ── Seed ─────────────────────────────────────────────────────────────────
# The first admin, created by `bun run cms:seed`. Delete after the first run.
SEED_ADMIN_EMAIL=kevin@nare.li
SEED_ADMIN_PASSWORD=
