# ── Mail ─────────────────────────────────────────────────────────────────
# Resend key for the /contact form and for Payload's own mail (admin password
# resets). Create one at https://resend.com/api-keys. The sender domain
# (nare.li, in app/api/contact/route.ts and payload.config.ts) must be
# verified in the same Resend account. Unset locally, Payload logs its mail
# to the console instead.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Payload ──────────────────────────────────────────────────────────────
# Signs admin sessions. Generate with: openssl rand -base64 32
# Changing it logs everyone out.
PAYLOAD_SECRET=

# Postgres. Locally this matches docker-compose.yml. In production the Neon
# integration on Vercel injects DATABASE_URL instead; either name works.
POSTGRES_URL=postgres://groot:groot@localhost:5433/groot

# Where the admin builds absolute URLs from.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# ── Media ────────────────────────────────────────────────────────────────
# Vercel Blob read/write token. Leave unset locally: uploads then go to
# public/uploads instead, and the Blob plugin stays switched off.
BLOB_READ_WRITE_TOKEN=

# ── Seed ─────────────────────────────────────────────────────────────────
# The first admin, created by `bun run cms:seed`. Delete after the first run.
SEED_ADMIN_EMAIL=kevin@nare.li
SEED_ADMIN_PASSWORD=
